# Copy to .env for local use. NEVER commit real values; in Azure these live in Key Vault / pipeline secret variables.
ENV=dev                       # dev | test | production  (production enforces every secret below)
DATABASE_URL=postgresql+asyncpg://regguard:CHANGE_ME@localhost:5432/regguard?ssl=require
REDIS_URL=rediss://default:CHANGE_ME@your-redis-host:6379          # fakeredis:// only allowed outside production
API_KEYS=<24+char-random>:admin:acme-bank,<24+char-random>:analyst:acme-bank,<24+char-random>:viewer:acme-bank
ENC_KEY=                      # 64 hex chars = 32 bytes.  python -c "import secrets;print(secrets.token_hex(32))"
CORS_ORIGINS=                 # comma separated; empty = same-origin only
DOCS_ENABLED=false            # hide /docs in production
# Optional Azure AI Foundry / Azure OpenAI deployment for the copilot (omit = deterministic offline analyst)
FOUNDRY_ENDPOINT=
FOUNDRY_KEY=
FOUNDRY_DEPLOYMENT=gpt-4o-mini
