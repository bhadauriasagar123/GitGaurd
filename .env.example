# Copy to .env for local use. NEVER commit real values; in Azure these live in Key Vault / pipeline secret variables.
ENV=dev                       # dev | test | production  (production enforces every secret below)
DATABASE_URL=postgresql+asyncpg://regguard:CHANGE_ME@localhost:5432/regguard?ssl=require  # pragma: allowlist secret
REDIS_MAX_CONNECTIONS=1                  # hard cap on Redis connections per process (default 1; requests queue instead of opening more)
REDIS_URL=rediss://default:<password>@your-redis-host:6379          # fakeredis:// only allowed outside production  # pragma: allowlist secret
API_KEYS=<24+char-random>:admin:acme-bank,<24+char-random>:analyst:acme-bank,<24+char-random>:viewer:acme-bank
ENC_KEY=                      # 64 hex chars = 32 bytes.  python -c "import secrets;print(secrets.token_hex(32))"
CORS_ORIGINS=                 # comma separated; empty = same-origin only
DOCS_ENABLED=false            # hide /docs in production
# Optional LLM for the copilot (omit = deterministic offline analyst; on any LLM error/rate limit the copilot falls back to it).
# Any OpenAI-compatible API, e.g. free Groq:  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
#   GitHub Models: https://models.github.ai/inference + openai/gpt-4o-mini (key = GitHub token with models:read)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai + gemini-2.0-flash   Ollama: http://localhost:11434/v1 (no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# ...or an Azure AI Foundry / Azure OpenAI deployment (used only when LLM_BASE_URL is empty)
FOUNDRY_ENDPOINT=
FOUNDRY_KEY=
FOUNDRY_DEPLOYMENT=gpt-4o-mini
